# Copy to .env and fill in. Used by both `npm start` and docker compose.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. When running locally (npm start) the default is fine.
# Under docker compose this is overridden to redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Optional: HTTP port the server listens on.
PORT=3000
