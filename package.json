{
  "name": "@agentionai/agents",
  "author": "Laurent Zuijdwijk",
  "version": "0.10.2",
  "description": "Agent Library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./mistral": {
      "types": "./dist/mistral.d.ts",
      "default": "./dist/mistral.js"
    },
    "./gemini": {
      "types": "./dist/gemini.d.ts",
      "default": "./dist/gemini.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    },
    "./vectorstore": {
      "types": "./dist/vectorstore/index.d.ts",
      "default": "./dist/vectorstore/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./viz": {
      "types": "./dist/viz/index.d.ts",
      "default": "./dist/viz/index.js"
    },
    "./chunkers": {
      "types": "./dist/chunkers/index.d.ts",
      "default": "./dist/chunkers/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion/index.d.ts",
      "default": "./dist/ingestion/index.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "default": "./dist/history/index.js"
    },
    "./history/plugins": {
      "types": "./dist/history/plugins/index.d.ts",
      "default": "./dist/history/plugins/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurentzuijdwijk/agention-lib.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'lib/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "prepare": "npm run build",
    "example": "tsx",
    "example:watch": "nodemon --watch examples --watch src --ext ts --exec 'ts-node --project tsconfig.esm.json' examples/index.ts",
    "docs": "npm run docs:api && npm run docs:site",
    "docs:api": "typedoc",
    "docs:site": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --access public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com",
    "publish:all": "npm run publish:npm && npm run publish:github"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "whatwg-url": "^14.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.23.0",
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.23.0",
    "@mistralai/mistralai": "^1.13.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "apache-arrow": "^18.1.0",
    "babel-jest": "^29.7.0",
    "docdash": "^2.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "globals": "^16.0.0",
    "jest": "^29.5.0",
    "jsdoc": "^4.0.4",
    "jsdoc-to-markdown": "^9.1.1",
    "nodemon": "^2.0.22",
    "openai": "^6.16.0",
    "prettier": "^2.8.7",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.0.3",
    "typescript-eslint": "^8.28.0",
    "vitepress": "^1.6.4",
    "voyageai": "^0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.23.0",
    "@mistralai/mistralai": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opensearch-project/opensearch": "^2.0.0",
    "apache-arrow": "^18.0.0",
    "openai": "^6.16.0",
    "voyageai": "^0.0.3"
  },
  "peerDependenciesMeta": {
    "@lancedb/lancedb": {
      "optional": true
    },
    "apache-arrow": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "voyageai": {
      "optional": true
    },
    "@opensearch-project/opensearch": {
      "optional": true
    }
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.5.1",
    "tokenx": "^1.2.1"
  }
}
